          "okf:liveVerified": false
        },
        {
          "@id": "urn:okf:els-api:operation:geo-lookup",
          "@type": "hydra:Operation",
          "dct:description": "Return a GeoJSON feature with boundary geometry and extended metadata for a GSS code.",
          "dct:source": {
            "@id": "https://github.com/ONSdigital/explore-local-statistics-app/wiki/Requesting-geographic-information"
          },
          "dct:title": "Look up one geographic area",
          "hydra:expects": {
            "@type": "hydra:IriTemplate",
            "hydra:mapping": [
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": true,
                "hydra:variable": "code",
                "okf:evidence": "wiki-and-source"
              }
            ],
            "hydra:template": "https://www.ons.gov.uk/explore-local-statistics/api/v1/geo/lookup/{code}"
          },
          "hydra:method": "GET",
          "okf:executionIncluded": false,
          "okf:liveVerified": false
        },
        {
          "@id": "urn:okf:els-api:operation:geo-related",
          "@type": "hydra:Operation",
          "dct:description": "Return parents, children, siblings and statistically similar areas.",
          "dct:source": {
            "@id": "https://github.com/ONSdigital/explore-local-statistics-app/wiki/Requesting-geographic-information"
          },
          "dct:title": "List all related areas",
          "hydra:expects": {
            "@type": "hydra:IriTemplate",
            "hydra:mapping": [
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": true,
                "hydra:variable": "code",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "includeNames",
                "okf:evidence": "wiki-and-source"
              }
            ],
            "hydra:template": "https://www.ons.gov.uk/explore-local-statistics/api/v1/geo/related/{code}"
          },
          "hydra:method": "GET",
          "okf:executionIncluded": false,
          "okf:liveVerified": false
        },
        {
          "@id": "urn:okf:els-api:operation:geo-parents",
          "@type": "hydra:Operation",
          "dct:description": "List parents for an area identified by GSS code.",
