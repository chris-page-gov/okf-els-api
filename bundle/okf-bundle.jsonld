  "dcat:service": [
    {
      "@id": "urn:okf:els-api:service",
      "@type": "dcat:DataService",
      "dcat:endpointDescription": {
        "@id": "https://github.com/ONSdigital/explore-local-statistics-app/wiki"
      },
      "dcat:endpointURL": {
        "@id": "https://www.ons.gov.uk/explore-local-statistics"
      },
      "dct:description": "The upstream wiki says this API is internal/private, is not intended for non-ONS web applications, may change without notice, and prevents cross-origin browser requests.",
      "dct:title": "Explore Local Statistics internal API",
      "hydra:supportedOperation": [
        {
          "@id": "urn:okf:els-api:operation:data",
          "@type": "hydra:Operation",
          "dct:description": "Filter one or more indicators by topic, geography, time, dimensions and measures.",
          "dct:source": {
            "@id": "https://github.com/ONSdigital/explore-local-statistics-app/wiki/Requesting-data"
          },
          "dct:title": "Filter and download statistical data",
          "hydra:expects": {
            "@type": "hydra:IriTemplate",
            "hydra:mapping": [
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": true,
                "hydra:variable": "format",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "topic",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "indicator",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "excludeMultivariate",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "time",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "timeNearest",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "geo",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "geoExtent",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "geoCluster",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "hasGeo",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "dimension_{code}",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "measure",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "includeNames",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "includeStatus",
                "okf:evidence": "wiki-and-source"
              }
            ],
            "hydra:template": "https://www.ons.gov.uk/explore-local-statistics/api/v1/data.{format}"
          },
          "hydra:method": "GET",
          "okf:executionIncluded": false,
          "okf:liveVerified": false
        },
        {
          "@id": "urn:okf:els-api:operation:geo-list",
          "@type": "hydra:Operation",
          "dct:description": "List names, codes and selected metadata for geographies represented in ELS.",
          "dct:source": {
            "@id": "https://github.com/ONSdigital/explore-local-statistics-app/wiki/Requesting-geographic-information"
          },
          "dct:title": "List geographic areas",
          "hydra:expects": {
            "@type": "hydra:IriTemplate",
            "hydra:mapping": [
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "geo",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "geoExtent",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "year",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "indicator",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "asLookup",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "groupByLevel",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "includeParents",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "includeChildren",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "includeDates",
                "okf:evidence": "wiki-and-source"
              },
              {
                "@type": "hydra:IriTemplateMapping",
                "hydra:required": false,
                "hydra:variable": "includeLevel",
                "okf:evidence": "wiki-and-source"
              }
            ],
            "hydra:template": "https://www.ons.gov.uk/explore-local-statistics/api/v1/geo/list"
          },
          "hydra:method": "GET",
          "okf:executionIncluded": false,
          "okf:liveVerified": false
        },
        {
          "@id": "urn:okf:els-api:operation:geo-levels",
          "@type": "hydra:Operation",
          "dct:description": "List geography-level keys, type prefixes and optionally their area codes.",
          "dct:source": {
            "@id": "https://github.com/ONSdigital/explore-local-statistics-app/wiki/Requesting-geographic-information"
