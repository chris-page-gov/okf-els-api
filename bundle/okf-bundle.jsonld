        {
          "@id": "urn:okf:els-api:operation:geo-boundaries",
          "@type": "hydra:Operation",
          "dct:description": "Return filtered, low-resolution boundaries as GeoJSON or TopoJSON.",
          "dct:source": {
            "@id": "https://github.com/ONSdigital/explore-local-statistics-app/wiki/Requesting-geographic-information"
          },
          "dct:title": "Get generalised boundaries",
          "hydra:expects": {
